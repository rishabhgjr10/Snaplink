# API base URL. Leave empty in production: the site calls /api same-origin and
# vercel.json rewrites it to the backend. Set it only when the API is on another origin
# (that origin must then be listed in the backend's CORS_ALLOWED_ORIGINS).
VITE_API_URL=

# Origin that serves short links (https://<this>/<code>). Defaults to the site's own origin,
# which works because vercel.json rewrites /:shortCode to the backend.
VITE_BACKEND_URL=

# Firebase Authentication (required; the app does not fall back to built-in values)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Sentry error tracking (nothing is loaded when empty)
VITE_SENTRY_DSN=
