{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://snaplink-backend-3rk3.onrender.com/api/:path*"
    },
    {
      "source": "/(robots.txt|sitemap.xml|icon.svg|icon.png|icon-dark.svg|icon-dark.png)",
      "destination": "/$1"
    },
    {
      "source": "/(login|signup|dashboard|analytics|settings|features|pricing|privacy|terms)",
      "destination": "/index.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/:shortCode",
      "destination": "https://snaplink-backend-3rk3.onrender.com/:shortCode"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
